# ===========================================================================
# iTrend RankVista - environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ===========================================================================

# --- Django core ------------------------------------------------------------
DEBUG=true
SECRET_KEY=change-me-generate-with-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# --- Relational database (auth, users, audit trail) -------------------------
# SQLite by default. Point at Postgres/MySQL in production if desired.
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# --- MongoDB (projects / ASINs / keywords / rankings) -----------------------
# Docker Compose: mongodb://rankvista:rankvista@mongodb:27017/rankvista?authSource=admin
# Native dev (containers started with `docker compose up -d mongodb redis`):
#   mongodb://rankvista:rankvista@127.0.0.1:27017/rankvista?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=rankvista
MONGODB_TIMEOUT_MS=5000

# Collection name overrides - remap to an existing database without code changes
MONGODB_COLLECTION_PROJECTS=projects
MONGODB_COLLECTION_ASINS=asins
MONGODB_COLLECTION_KEYWORDS=keywords
MONGODB_COLLECTION_RANKINGS=rankings

# --- Redis -------------------------------------------------------------------
# Optional in local development: the app degrades to a local-memory cache
# automatically when Redis is unreachable.
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TIMEOUT_SECONDS=300

# --- Bootstrap administrator (consumed by `manage.py bootstrap_admin`) -------
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# --- Feature flags ------------------------------------------------------------
ENABLE_DJANGO_ADMIN=false

# --- Security (set every value to `true` in production) ----------------------
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_AGE=1209600

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
