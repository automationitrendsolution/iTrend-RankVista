# ===========================================================================
# iTrend RankVista - environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ===========================================================================

# --- Django core ------------------------------------------------------------
DEBUG=true
SECRET_KEY=change-me-generate-with-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# --- MongoDB (the only datastore: auth, sessions, audit and analytics) ------
# Docker Compose: mongodb://rankvista:rankvista@mongodb:27017/rankvista?authSource=admin
# Native dev (containers started with `docker compose up -d mongodb redis`):
#   mongodb://rankvista:rankvista@127.0.0.1:27018/rankvista?authSource=admin
MONGODB_URI=mongodb://rankvista:rankvista@127.0.0.1:27018/rankvista?authSource=admin
MONGODB_DATABASE=rankvista
MONGODB_TIMEOUT_MS=5000

# Collection name overrides - remap to an existing database without code changes
MONGODB_COLLECTION_PROJECTS=projects
MONGODB_COLLECTION_ASINS=asins
MONGODB_COLLECTION_KEYWORDS=keywords
MONGODB_COLLECTION_RANKINGS=rankings

# --- Redis -------------------------------------------------------------------
# Optional in local development: the app degrades to a local-memory cache
# automatically when Redis is unreachable.
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TIMEOUT_SECONDS=300

# --- Bootstrap administrator (consumed by `manage.py bootstrap_admin`) -------
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# --- Host ports published by docker compose --------------------------------
# Mongo defaults to 27018 so a locally installed mongod on 27017 never clashes.
MONGO_ROOT_USERNAME=rankvista
MONGO_ROOT_PASSWORD=rankvista
# Published interface. Keep 127.0.0.1 in production and front the app
# with a reverse proxy; 0.0.0.0 would expose these services publicly.
BIND_HOST=127.0.0.1
MONGODB_PORT=27018
REDIS_PORT=6379
WEB_PORT=8000

# --- Source data warehouse (MySQL) ------------------------------------------
# Live rank history. Use a READ-ONLY account. Never commit real values.
SOURCE_DB_ENABLED=false
SOURCE_DB_HOST=
SOURCE_DB_PORT=3306
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
SOURCE_DB_NAME=
SOURCE_DB_RANK_TABLE=datarova_rank_history
SOURCE_DB_ASIN_TABLE=datarova_asin_registry
SOURCE_DB_KEYWORD_TABLE=datarova_asin_keyword_summary
SOURCE_DB_CATEGORY_TABLE=datarova_asin_category
SOURCE_DB_SYNC_TABLE=datarova_sync_log
SOURCE_DB_TIMEOUT=15
SOURCE_DB_READ_TIMEOUT=60

# --- Feature flags ------------------------------------------------------------
ENABLE_DJANGO_ADMIN=false

# --- Security (set every value to `true` in production) ----------------------
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_AGE=1209600

# --- Credential encryption at rest ------------------------------------------
# Connection credentials must stay reversible (the server has to receive them),
# so they are encrypted, not hashed. Generate a token with:
#   uv run python manage.py secrets_tool encrypt --name SOURCE_DB_PASSWORD
# then paste the resulting `enc:...` value over the plaintext here.
# Keep this key OUT of .env in production - inject it from your secret store.
RANKVISTA_SECRET_KEY=

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
